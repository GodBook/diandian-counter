<resources>
    <style name="BaseAppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#356751</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F7F6F2</item>
        <item name="android:navigationBarColor">#F7F6F2</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F7F6F2</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="AppTheme" parent="BaseAppTheme" />
</resources>
